{# ===========================================================================
   Home Assistant Ultimate Theme - master template
   ---------------------------------------------------------------------------
   Every rendered theme comes from this one file. Three aesthetic modes x
   (1 base + 23 areas) = 72 themes, all sharing the engine below.

   Feature summary:
     * glass card engine  - ::before backdrop-filter layer, inset bevel stack,
                            blurred sidebar and drawer
     * specular sheen     - ::after top-edge rim; real glass has a bright edge,
                            not just blur
     * @supports fallback - degrades to solid cards where backdrop-filter is
                            unsupported, instead of rendering unreadable
     * fixed backdrop     - painted onto a fixed pseudo-element, because
                            background-attachment: fixed misbehaves on iOS
     * per-view hook      - --ultimate-view-background for per-tab backdrops
     * hover lift         - guarded by prefers-reduced-motion
     * compatibility      - Mushroom, Bubble Card and button-card exclusions

   Third-party notices for derived portions: see NOTICE.md
=========================================================================== #}
#
# {{ theme_name }}
{% if area %}# Area: {{ area.name }}  ({{ area.icon }})
{% endif %}# Generated by build/generate_themes.py - do not edit by hand.
#
{# Values MUST be quoted. A hex colour like #1e1e2e is a comment in YAML when
   left bare, which silently turns the value into null and makes Home Assistant
   reject the entire themes file. #}
"{{ theme_name }}":
  modes:
    light:
{% for k, v in m.light.items() %}      {{ k }}: "{{ v }}"
{% endfor %}
    dark:
{% for k, v in m.dark.items() %}      {{ k }}: "{{ v }}"
{% endfor %}

  # =========================================================================
  # BACKGROUND
  # =========================================================================
{% if bg_url %}
  ultimate-background: "url('{{ bg_url }}')"
  background-image: "center / cover no-repeat fixed url('{{ bg_url }}')"
  lovelace-background: var(--background-image)
{% else %}
  ultimate-background: "{{ m.fallback_gradient }}"
  background-image: "{{ m.fallback_gradient }}"
  lovelace-background: var(--background-image)
{% endif %}
  app-theme-color: "{{ header_tint }}"

  # =========================================================================
  # GLASS SYSTEM TOKENS
  # =========================================================================
  ha-card-backdrop-filter: "{{ m.blur }}"
  ha-card-border-radius: {{ m.radius }}
  ha-card-features-border-radius: var(--ha-card-border-radius)
  ha-card-border-width: {{ m.border_width }}
  ha-card-border-color: "{{ m.border_color }}"
  ha-card-glass-tint: "{{ m.glass_tint }}"
  ha-card-glass-sheen: "{{ m.sheen }}"
  ha-card-glass-inset-shadow: >
    {{ m.inset_shadow }}
  ha-card-box-shadow: >
    {{ m.inset_shadow }}
  ultimate-glow-color: "{{ accent }}"
  ultimate-transition: {{ m.transition }}

  # =========================================================================
  # COLOUR - accent driven by this area
  # =========================================================================
  primary-color: "{{ accent }}"
  accent-color: var(--primary-color)
  light-primary-color: "{{ m.light_primary }}"
  divider-color: "{{ m.divider }}"
{% for i, shade in ramp %}  ha-color-primary-{{ i }}: "{{ shade }}"
{% endfor %}
  # Apple / semantic palette
{% for k, v in m.palette.items() %}  {{ k }}: "{{ v }}"
{% endfor %}

  # =========================================================================
  # TEXT
  # =========================================================================
  primary-text-color: "{{ m.text_primary }}"
  secondary-text-color: "{{ m.text_secondary }}"
  disabled-text-color: "{{ m.text_disabled }}"
  text-primary-color: var(--primary-text-color)
  text-dark-color: var(--primary-text-color)
  ha-color-text-secondary: var(--secondary-text-color)
  lumo-body-text-color: var(--primary-text-color)

  # =========================================================================
  # SIDEBAR
  # =========================================================================
  sidebar-background-color: "{{ m.sidebar_bg }}"
  sidebar-icon-color: var(--light-primary-color)
  sidebar-text-color: var(--light-primary-color)
  sidebar-selected-background-color: "{{ m.sidebar_selected_bg }}"
  sidebar-selected-icon-color: var(--primary-color)
  sidebar-selected-text-color: var(--sidebar-selected-icon-color)

  # =========================================================================
  # HEADER
  # =========================================================================
  app-header-background-color: "{{ m.header_bg }}"
  app-header-backdrop-filter: var(--ha-card-backdrop-filter)
  app-header-text-color: var(--primary-text-color)
  app-header-edit-background-color: "{{ m.header_edit_bg }}"

  # =========================================================================
  # CARDS / SURFACES
  # =========================================================================
  card-background-color: "{{ m.surface }}"
  paper-card-background-color: var(--ha-card-background)
  paper-listbox-background-color: "{{ m.surface }}"
  rgb-card-background-color: "{{ m.surface_rgb }}"
  clear-background-color: var(--ha-card-background)
  mdc-theme-surface: "{{ m.surface }}"
  material-background-color: "{{ m.surface }}"
  table-row-background-color: "{{ m.surface }}"
  table-row-alternative-background-color: "{{ m.surface_alt }}"
  md-list-container-color: none

  # =========================================================================
  # DIALOGS
  # =========================================================================
  ha-dialog-surface-background: "{{ m.dialog_bg }}"
  ha-dialog-surface-backdrop-filter: var(--ha-card-backdrop-filter)
  ha-dialog-scrim-backdrop-filter: blur(2px)
  dialog-box-shadow: var(--ha-card-box-shadow)
  paper-dialog-background-color: "{{ m.dialog_bg }}"
  more-info-header-background: "{{ m.header_bg }}"
  mdc-dialog-scrim-color: "{{ m.scrim }}"

  # =========================================================================
  # STATES, SLIDERS, SWITCHES
  # =========================================================================
  state-icon-color: var(--primary-text-color)
  state-icon-active-color: var(--primary-color)
  state-icon-unavailable-color: var(--disabled-text-color)
  state-inactive-color: var(--disabled-text-color)
  paper-item-icon-color: var(--primary-text-color)
  paper-item-icon-active-color: var(--state-icon-active-color)
  paper-slider-knob-color: "#FFFFFF"
  paper-slider-knob-start-color: var(--paper-slider-knob-color)
  paper-slider-pin-color: var(--paper-slider-knob-color)
  paper-slider-active-color: var(--primary-color)
  paper-slider-secondary-color: var(--paper-slider-knob-color)
  paper-slider-container-color: "{{ m.slider_track }}"
  ha-slider-background: none !important
  switch-checked-track-color: var(--primary-color)
  switch-checked-button-color: "#FFFFFF"
  switch-unchecked-track-color: var(--disabled-text-color)
  switch-unchecked-button-color: "#FFFFFF"
  paper-toggle-button-checked-bar-color: var(--primary-color)
  paper-toggle-button-checked-button-color: "#FFFFFF"
  paper-toggle-button-unchecked-bar-color: var(--disabled-text-color)
  paper-toggle-button-unchecked-button-color: "#FFFFFF"

  # =========================================================================
  # BADGES / LABELS
  # =========================================================================
  ha-badge-border-radius: {{ m.badge_radius }}
  label-badge-background-color: "{{ m.surface }}"
  label-badge-text-color: var(--primary-text-color)
  label-badge-red: var(--red-color)

  # =========================================================================
  # INPUTS / FORMS
  # =========================================================================
  input-ink-color: var(--primary-text-color)
  input-fill-color: transparent
  input-disabled-fill-color: transparent
  input-label-ink-color: var(--primary-text-color)
  input-disabled-ink-color: var(--disabled-text-color)
  input-dropdown-icon-color: var(--primary-text-color)
  input-idle-line-color: var(--secondary-text-color)
  input-hover-line-color: var(--primary-color)
  ha-color-form-background: var(--ha-card-background)
  ha-color-form-background-hover: var(--ha-card-background)
  ha-color-form-background-disabled: var(--ha-card-background)
  mdc-checkbox-unchecked-color: var(--secondary-text-color)
  mdc-radio-unchecked-color: var(--secondary-text-color)
  codemirror-property: var(--accent-color)
  markdown-code-background-color: "{{ m.code_bg }}"
  code-editor-background-color: "{{ m.code_bg }}"

  # =========================================================================
  # DROPDOWNS (HA 2025.x web-awesome)
  # =========================================================================
  wa-shadow-m: var(--ha-card-box-shadow)
  wa-border-radius-s: var(--ha-card-border-radius)
  wa-border-radius-m: {{ m.radius }}
  wa-border-width-s: 0px
  wa-color-neutral-fill-normal: "{{ m.hover_fill }}"
  ha-color-on-neutral-normal: var(--primary-text-color)
  ha-color-fill-primary-quiet-resting: "{{ m.hover_fill }}"
  ha-color-fill-primary-quiet-hover: "{{ m.hover_fill_strong }}"

  # =========================================================================
  # MUSHROOM geometry tokens
  # =========================================================================
  mush-spacing: {{ m.mush_spacing }}
  mush-icon-border-radius: {{ m.mush_radius }}
  mush-control-border-radius: {{ m.mush_radius }}
  mush-chip-border-radius: {{ m.mush_radius }}
  mush-chip-background: var(--ha-card-background)
  mush-rgb-white: 255, 255, 255
  mush-title-font-weight: 600
  mush-title-letter-spacing: 0.02em
  ha-tile-icon-border-radius: {{ m.mush_radius }}

  # =========================================================================
  # MINI MEDIA PLAYER / MISC CUSTOM CARDS
  # =========================================================================
  mcg-title-letter-spacing: 0.15em
  mini-media-player-base-color: var(--primary-text-color)
  mini-media-player-icon-color: var(--primary-text-color)

  # =========================================================================
  # CARD-MOD
  # =========================================================================
  card-mod-theme: "{{ theme_name }}"

  card-mod-root: |
    /* ---- iOS-safe fixed background ------------------------------------
       background-attachment: fixed is janky/ignored on iOS Safari and the HA
       companion app. Painting the backdrop onto a fixed pseudo-element gives
       the same parallax-free result everywhere. */
    :host::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: var(--ultimate-background);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      z-index: -2;
      pointer-events: none;
    }
    :host::after {
      content: '';
      position: fixed;
      inset: 0;
      background: {{ m.background_scrim }};
      z-index: -1;
      pointer-events: none;
    }

    /* ---- HA colour tokens ---------------------------------------------- */
    :host {
{% for k, v in m.tokens.items() %}      {{ k }}: {{ v }};
{% endfor %}    }

    /* ---- scrollbars ---------------------------------------------------- */
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: {{ m.scrollbar }};
      border-radius: 8px;
    }
    ::-webkit-scrollbar-thumb:hover { background: var(--primary-color); }

  card-mod-card: |
    /* ================= BASE RESET ================= */
    ha-card {
      background: transparent;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      border: {{ m.border_width }} solid var(--ha-card-border-color);
      transition: var(--ultimate-transition);
    }

    /* ================= GLASS LAYER =================
       Sits behind the card content so blur never touches text. */
    ha-card::before {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--ha-card-glass-tint);
      backdrop-filter: var(--ha-card-backdrop-filter);
      -webkit-backdrop-filter: var(--ha-card-backdrop-filter);
      z-index: -1;
      pointer-events: none;
      border-radius: inherit;
      box-shadow: var(--ha-card-glass-inset-shadow);
    }

    /* ================= SPECULAR SHEEN =================
       Real glass has a bright top rim. This is the single biggest visual
       upgrade over the source themes, which only blur. */
    ha-card::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background: var(--ha-card-glass-sheen);
      z-index: 0;
      mix-blend-mode: {{ m.sheen_blend }};
    }
    ha-card > * { position: relative; z-index: 1; }

    /* ================= HOVER LIFT ================= */
    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      ha-card:hover {
        transform: translateY(-1px);
      }
      ha-card:hover::before {
        box-shadow: var(--ha-card-glass-inset-shadow),
                    {{ m.hover_glow }};
      }
    }

    /* ================= NO-BACKDROP-FILTER FALLBACK =================
       Old WebViews (some Android companion builds) do not support
       backdrop-filter. Without this the cards render fully transparent
       and become unreadable over the background image. */
    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
      ha-card::before {
        background: {{ m.fallback_card_bg }};
      }
    }

    /* ================= EXCLUSIONS =================
       Cards that must stay flat, or that draw their own surface. */
    :host(hui-heading-card) ha-card,
    :host(hui-glance-card) ha-card,
    :host(mushroom-title-card) ha-card,
    :host(mushroom-chips-card) ha-card,
    :host(.type-custom-bubble-card) ha-card,
    ha-card.text-only {
      background: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      box-shadow: none !important;
      border: none !important;
    }
    :host(hui-heading-card) ha-card::before,
    :host(hui-heading-card) ha-card::after,
    :host(hui-glance-card) ha-card::before,
    :host(hui-glance-card) ha-card::after,
    :host(mushroom-title-card) ha-card::before,
    :host(mushroom-title-card) ha-card::after,
    :host(mushroom-chips-card) ha-card::before,
    :host(mushroom-chips-card) ha-card::after,
    :host(.type-custom-bubble-card) ha-card::before,
    :host(.type-custom-bubble-card) ha-card::after,
    ha-card.text-only::before,
    ha-card.text-only::after {
      content: none !important;
      background: none !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
    }
    :host(.type-custom-bubble-card) ha-card {
      border-radius: 0px !important;
    }

    /* ================= DATA TABLES ================= */
    .mdc-data-table,
    .mdc-data-table__row,
    ha-sankey-chart {
      background: none !important;
    }
    .mdc-data-table__header-cell {
      background: var(--ha-card-glass-tint) !important;
      backdrop-filter: var(--ha-card-backdrop-filter) !important;
      -webkit-backdrop-filter: var(--ha-card-backdrop-filter) !important;
    }

  card-mod-sidebar: |
    :host {
      background: none !important;
      backdrop-filter: var(--ha-card-backdrop-filter);
      -webkit-backdrop-filter: var(--ha-card-backdrop-filter);
    }
    ha-list-item-button,
    ha-list-item-button.selected::before,
    ha-md-list-item,
    ha-md-list-item.selected::before,
    paper-icon-item {
      border-radius: var(--ha-card-border-radius) !important;
      --ha-list-item-focus-radius: var(--ha-card-border-radius) !important;
    }
    ha-md-list-item.selected,
    paper-icon-item.iron-selected {
      background: var(--ha-color-fill-primary-quiet-resting) !important;
    }

  card-mod-drawer-yaml: |
    .: |
      .mdc-drawer {
        background-color: var(--sidebar-background-color) !important;
        backdrop-filter: var(--ha-card-backdrop-filter);
        -webkit-backdrop-filter: var(--ha-card-backdrop-filter);
      }
      .sidebar-shell {
        background-color: var(--sidebar-background-color) !important;
      }
    wa-drawer$: |
      dialog {
        backdrop-filter: var(--ha-card-backdrop-filter);
        -webkit-backdrop-filter: var(--ha-card-backdrop-filter);
      }

  card-mod-view: |
    /* Per-view background override hook.
       Set --ultimate-view-background in a view's card_mod to give that single
       tab its own backdrop - see docs/PER-VIEW-BACKGROUNDS.md */
    :host::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: var(--ultimate-view-background, none);
      background-size: cover;
      background-position: center;
      z-index: -2;
      pointer-events: none;
      opacity: var(--ultimate-view-background-opacity, 1);
    }
